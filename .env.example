# ------------------------------------------------------------------------------
# Application. Change APP_NAME and APP_URL for every project you clone from this template.
# ------------------------------------------------------------------------------
APP_NAME="Admin Template"
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (also hides /preview and /admin/components/*)
APP_DEBUG=true
# Laragon serves each folder as https://<folder>.test
APP_URL=https://admin-template.test

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
# Time zone can also be changed in Admin > Settings
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database. SQLite works out of the box; switch to MySQL for real projects:
#   DB_CONNECTION=mysql  DB_HOST=127.0.0.1  DB_PORT=3306  DB_DATABASE=your_db  DB_USERNAME=root  DB_PASSWORD=
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Mail. "log" writes emails (e.g. password reset links) to storage/logs/laravel.log.
# For real delivery use SMTP:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.example.com  MAIL_PORT=587  MAIL_USERNAME=...  MAIL_PASSWORD=...  MAIL_SCHEME=null
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Look & feel (see config/ui.php for all values)
# ------------------------------------------------------------------------------
# vertical | horizontal | condensed
UI_LAYOUT=vertical
# default | boxed | fluid
UI_WIDTH=default
# vertical layout only: default | folded | folded-hover
UI_SIDEBAR=default
# vertical layout only: default | end | transparent
UI_SIDEBAR_STYLE=default
UI_NAVBAR_STICKY=false
# default | floating
UI_NAVBAR_STYLE=default
# blue azure indigo purple pink red orange yellow lime green teal cyan
UI_PRIMARY=blue
# neutral slate gray zinc stone mist
UI_BASE=neutral
# sans-serif serif monospace comic
UI_FONT=sans-serif
# 0 | 0.5 | 1 | 1.5 | 2
UI_RADIUS=1
# Tabler preview gallery at /preview (local only). Remove it for good with: php artisan template:strip-preview
UI_PREVIEW=true
